{
  "authentication": {
    "strategy": "plugin-command",
    "protocol": "neuxally-auth/1",
    "command": "node",
    "args": [
      "./.neuxally/auth/authorize.mjs"
    ],
    "scopes": [
      "offline_access",
      "docx:document",
      "bitable:app",
      "calendar:calendar",
      "task:task:read",
      "task:task:write"
    ]
  }
}
