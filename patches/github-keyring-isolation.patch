+// privateService 将全部底层操作及官方迁移限定到明确的私有配置目录。
+// 无有效目录时拒绝访问，不回退到用户 gh 或旧应用的共享服务名。
+func privateService(service string) (string, error) {
+	profile := os.Getenv("GH_CONFIG_DIR")
+	if !filepath.IsAbs(profile) {
+		return "", errors.New("private GH_CONFIG_DIR is required for keyring access")
+	}
+	canonical, err := filepath.EvalSymlinks(profile)
+	if err != nil {
+		return "", errors.New("private GH_CONFIG_DIR must exist")
+	}
+	info, err := os.Stat(canonical)
+	if err != nil || !info.IsDir() {
+		return "", errors.New("private GH_CONFIG_DIR must be a directory")
+	}
+	digest := sha256.Sum256([]byte(filepath.Clean(canonical)))
+	return fmt.Sprintf("neuxally:%x:%s", digest, service), nil
+}
