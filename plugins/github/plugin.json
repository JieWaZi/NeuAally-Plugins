{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "github",
  "version": "1.0.2",
  "description": "检索仓库代码、跟进 Issue，协助整理与评审 Pull Request。",
  "author": {
    "name": "GitHub",
    "url": "https://github.com/github"
  },
  "homepage": "https://github.com/github/github-mcp-server",
  "license": "MIT",
  "keywords": [
    "GitHub",
    "仓库",
    "Issue",
    "Pull Request"
  ],
  "extensions": {
    "com.ally": {
      "displayName": "GitHub",
      "provider": "github",
      "scopes": [
        "repo",
        "read:org",
        "gist"
      ],
      "requiredComponents": [
        "github"
      ],
      "privacyPolicy": "https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement",
      "termsOfService": "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service"
    }
  },
  "repository": "https://github.com/github/github-mcp-server"
}
