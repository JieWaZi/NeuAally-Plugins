{
  "authentication": {
    "strategy": "plugin-command",
    "protocol": "neuxally-auth/1",
    "command": "node",
    "args": [
      "./.neuxally/auth/authorize.mjs"
    ],
    "scopes": [
      "repo",
      "read:org",
      "gist"
    ],
    "preferredAction": "open-url",
    "bindings": [
      {
        "runtime": "codex",
        "server": "github",
        "url": "https://api.githubcopilot.com/mcp/",
        "header": "Authorization"
      },
      {
        "runtime": "claude",
        "server": "github",
        "url": "https://api.githubcopilot.com/mcp/",
        "header": "Authorization"
      }
    ]
  }
}
